USE_PROCD=1
PROCD_DEBUG=1

START=03
STOP=97

start_service() {
	procd_open_instance
	procd_set_param command /etc/initscripts/start_cnss_le start
	procd_close_instance
}

stop_service() {
	echo "Stopping cnss Instance"
}
